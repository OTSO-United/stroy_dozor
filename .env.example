POSTGRES_PASSWORD=local-demo-only
# Packaged in the image; prepare locally with scripts/export_yolo.py before build.
MODEL_MANIFEST=/models/yolo26m/manifest.json
# Local access. HTTPS proxy is enabled with --profile public.
APP_PORT=8080
# Optional official mirror when Docker Hub is unavailable:
# NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim-bookworm
# Twenty RTSP session slots; measure decode/RAM and total detector latency.
WORKER_THREADS=20
# Optional Photon-compatible geocoders. Empty values disable the corresponding lookup.
GEOCODER_REVERSE_URL=https://photon.komoot.io/reverse
GEOCODER_SEARCH_URL=https://photon.komoot.io/api
